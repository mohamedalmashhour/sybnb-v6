# QC (Québec) API — never reuse V6 / Syria values here.
QC_DATABASE_URL=postgresql://localhost/qc_dev
QC_TEST_DATABASE_URL=postgresql://localhost/qc_test
# At least 32 random characters: openssl rand -base64 48
QC_AUTH_SECRET=
# Comma-separated emails that receive the ADMIN role when they sign in.
QC_ADMIN_EMAILS=
QC_API_HOST=127.0.0.1
QC_API_PORT=3061
QC_CORS_ORIGINS=http://127.0.0.1:5190,http://127.0.0.1:5191
# console (dev) | memory (tests) | resend (needs QC_RESEND_API_KEY + QC_MAIL_FROM)
QC_MAIL_MODE=console
# Unset = payments disabled. 'simulated' confirms without charging (dev only, refused in production).
# 'stripe' = Stripe Checkout with TEST keys only (live keys are refused at startup).
QC_PAYMENTS_MODE=
# Use a Stripe sandbox. Prefer a restricted key (rk_test_) with Checkout Sessions write,
# PaymentIntents write and Refunds write.
QC_STRIPE_SECRET_KEY=
# From `stripe listen --forward-to 127.0.0.1:3061/api/webhooks/stripe` (dev) or the Dashboard endpoint.
QC_STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back after Checkout.
QC_QTR_URL=http://127.0.0.1:5191
QC_QRIDE_URL=http://127.0.0.1:5190
