// QC (Québec) backend schema — separate database from the V6 master (QC_DATABASE_URL).
// Money is integer cents in CAD. Calendar dates are Québec-local dates (America/Toronto).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("QC_DATABASE_URL")
}

enum Role {
  GUEST
  HOST
  DRIVER
  ADMIN

  @@map("qc_role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED

  @@map("qc_account_status")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("qc_application_status")
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED

  @@map("qc_listing_status")
}

enum StayStatus {
  HOLD
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED

  @@map("qc_stay_status")
}

enum RideCategory {
  STANDARD
  COMFORT
  XL

  @@map("qc_ride_category")
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("qc_ride_status")
}

model User {
  id        String        @id @default(uuid()) @db.Uuid
  email     String        @unique
  name      String?
  locale    String        @default("fr-CA")
  roles     Role[]        @default([GUEST])
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")

  sessions     Session[]
  applications RoleApplication[] @relation("applicant")
  driver       DriverProfile?
  listings     Listing[]
  stays        StayBooking[]
  rideQuotes   RideQuote[]
  ridesAsRider Ride[]            @relation("rider")
  ridesAsDriver Ride[]           @relation("driver")

  @@map("qc_users")
}

model LoginCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("qc_login_codes")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("qc_sessions")
}

model RoleApplication {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  role       Role
  status     ApplicationStatus @default(PENDING)
  details    Json
  note       String?
  reviewedBy String?           @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?         @map("reviewed_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  user       User              @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, role])
  @@map("qc_role_applications")
}

model DriverProfile {
  userId          String       @id @map("user_id") @db.Uuid
  category        RideCategory @default(STANDARD)
  vehicle         Json
  licenceExpiry   DateTime     @map("licence_expiry") @db.Date
  insuranceExpiry DateTime     @map("insurance_expiry") @db.Date
  online          Boolean      @default(false)
  lat             Float?
  lng             Float?
  lastSeenAt      DateTime?    @map("last_seen_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("qc_driver_profiles")
}

model Listing {
  id                 String        @id @default(uuid()) @db.Uuid
  hostId             String        @map("host_id") @db.Uuid
  title              String
  description        String
  address            String
  city               String
  lat                Float
  lng                Float
  registrationNumber String?       @map("registration_number")
  maxGuests          Int           @map("max_guests")
  bedrooms           Int
  beds               Int
  bathrooms          Float
  nightlyCents       Int           @map("nightly_cents")
  cleaningCents      Int           @default(0) @map("cleaning_cents")
  minNights          Int           @default(1) @map("min_nights")
  amenities          String[]      @default([])
  photos             String[]      @default([])
  status             ListingStatus @default(DRAFT)
  reviewNote         String?       @map("review_note")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  host               User          @relation(fields: [hostId], references: [id])
  blocks             CalendarBlock[]
  bookings           StayBooking[]

  @@index([status, city])
  @@map("qc_listings")
}

model CalendarBlock {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("qc_calendar_blocks")
}

model StayBooking {
  id            String     @id @default(uuid()) @db.Uuid
  listingId     String     @map("listing_id") @db.Uuid
  guestId       String     @map("guest_id") @db.Uuid
  checkIn       DateTime   @map("check_in") @db.Date
  checkOut      DateTime   @map("check_out") @db.Date
  guests        Int
  status        StayStatus @default(HOLD)
  holdExpiresAt DateTime?  @map("hold_expires_at")
  quote         Json
  totalCents    Int        @map("total_cents")
  refundCents   Int?       @map("refund_cents")
  cancelledBy   String?    @map("cancelled_by")
  cancelledAt   DateTime?  @map("cancelled_at")
  confirmedAt   DateTime?  @map("confirmed_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  listing       Listing    @relation(fields: [listingId], references: [id])
  guest         User       @relation(fields: [guestId], references: [id])

  @@index([listingId, status])
  @@index([guestId])
  @@map("qc_stay_bookings")
}

model RideQuote {
  id         String       @id @default(uuid()) @db.Uuid
  riderId    String       @map("rider_id") @db.Uuid
  category   RideCategory
  pickup     Json
  dropoff    Json
  distanceM  Int          @map("distance_m")
  durationS  Int          @map("duration_s")
  breakdown  Json
  totalCents Int          @map("total_cents")
  expiresAt  DateTime     @map("expires_at")
  usedAt     DateTime?    @map("used_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  rider      User         @relation(fields: [riderId], references: [id])
  ride       Ride?

  @@map("qc_ride_quotes")
}

model Ride {
  id           String       @id @default(uuid()) @db.Uuid
  quoteId      String       @unique @map("quote_id") @db.Uuid
  riderId      String       @map("rider_id") @db.Uuid
  driverId     String?      @map("driver_id") @db.Uuid
  category     RideCategory
  pickup       Json
  dropoff      Json
  scheduledFor DateTime?    @map("scheduled_for")
  status       RideStatus   @default(REQUESTED)
  totalCents   Int          @map("total_cents")
  breakdown    Json
  cancelledBy  String?      @map("cancelled_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  acceptedAt   DateTime?    @map("accepted_at")
  completedAt  DateTime?    @map("completed_at")
  quote        RideQuote    @relation(fields: [quoteId], references: [id])
  rider        User         @relation("rider", fields: [riderId], references: [id])
  driver       User?        @relation("driver", fields: [driverId], references: [id])
  events       RideEvent[]

  @@index([status, category])
  @@index([riderId])
  @@index([driverId])
  @@map("qc_rides")
}

// Append-only trip safety record (see QC/QRide/TRIP-SAFETY-RECORD.md).
model RideEvent {
  id      String   @id @default(uuid()) @db.Uuid
  rideId  String   @map("ride_id") @db.Uuid
  type    String
  actorId String?  @map("actor_id") @db.Uuid
  data    Json?
  at      DateTime @default(now())
  ride    Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, at])
  @@map("qc_ride_events")
}

model AuditLog {
  id      String   @id @default(uuid()) @db.Uuid
  actorId String?  @map("actor_id") @db.Uuid
  action  String
  target  String?
  data    Json?
  at      DateTime @default(now())

  @@index([action, at])
  @@map("qc_audit_log")
}
