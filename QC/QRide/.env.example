# Public browser-only key. Restrict to QRide HTTP referrers and approved Maps APIs.
# Never place GOOGLE_MAPS_API_KEY (server key) or service-account JSON in a VITE_ variable.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# QC API base URL (QC/server). Defaults to http://127.0.0.1:3061.
VITE_QC_API_URL=
